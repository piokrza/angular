{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng run angular:serve-mock",
    "start:mock-server": "nodemon --watch mock/ --exec \"ts-node -P ./mock/tsconfig-mock.json \" ./mock/server.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "lint": "ng lint",
    "clear": "rm -rf .angular dist node_modules package-lock.json"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,json}": "prettier --write"
  }
}
